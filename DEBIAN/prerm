#!/bin/bash
set -e

case "$1" in
remove | upgrade | deconfigure)
	# Stop user services if running
	for user_home in /home/*; do
		if [ -d "$user_home" ]; then
			username=$(basename "$user_home")
			if id "$username" >/dev/null 2>&1; then
				sudo -u "$username" systemctl --user disable --now battery-full-alert.timer 2>/dev/null || true
			fi
		fi
	done
	;;
esac

exit 0
