#!/bin/bash
set -e

case "$1" in
remove | purge)
	# Clean up user cache files
	for user_home in /home/*; do
		if [ -d "$user_home" ]; then
			rm -f "$user_home/.cache/battery-full-notified"
			if [ "$1" = "purge" ]; then
				rm -f "$user_home/.config/battery-full-alert.conf"
			fi
		fi
	done
	;;
esac

exit 0
